        "type": "controller",
        "endpoint": "system_hardware/x10remote",
        "method": "saveGeneral"
      },
      "saveButton": {
        "label": "TRANSLATE.X10.SAVE",
        "data": [
          "enabled",
          "debounce_ms",
          "repeat_ms",
          "ignore_scancodes",
          "watchdog",
          "log_presses",
          "web_port"
        ]
      },
      "content": [
        {
          "id": "enabled",
          "element": "switch",
          "label": "TRANSLATE.X10.ENABLED",
          "doc": "TRANSLATE.X10.ENABLED_DOC",
          "value": true
        },
        {
          "id": "debounce_ms",
          "type": "number",
          "element": "input",
          "label": "TRANSLATE.X10.DEBOUNCE",
          "doc": "TRANSLATE.X10.DEBOUNCE_DOC",
          "attributes": [
            {
              "min": 0
            },
            {
              "max": 2000
            }
          ],
          "value": 300
        },
        {
          "id": "repeat_ms",
          "type": "number",
          "element": "input",
          "label": "TRANSLATE.X10.REPEAT",
          "doc": "TRANSLATE.X10.REPEAT_DOC",
          "attributes": [
            {
              "min": 50
            },
            {
              "max": 2000
            }
          ],
          "value": 150
        },
        {
          "id": "ignore_scancodes",
          "type": "text",
          "element": "input",
          "label": "TRANSLATE.X10.IGNORE",
          "doc": "TRANSLATE.X10.IGNORE_DOC",
          "value": "0x00"
        },
        {
          "id": "watchdog",
          "element": "switch",
          "label": "TRANSLATE.X10.WATCHDOG",
          "doc": "TRANSLATE.X10.WATCHDOG_DOC",
          "value": true
        },
        {
          "id": "log_presses",
          "element": "switch",
          "label": "TRANSLATE.X10.LOG_PRESSES",
          "doc": "TRANSLATE.X10.LOG_PRESSES_DOC",
          "value": false
        },
        {
          "id": "web_port",
          "type": "number",
          "element": "input",
          "label": "TRANSLATE.X10.WEB_PORT",
          "doc": "TRANSLATE.X10.WEB_PORT_DOC",
          "attributes": [
            {
              "min": 1024
            },
            {
              "max": 65535
            }
          ],
          "value": 7710
        }
      ]
    },
