        },
        {
          "id": "allow_shell",
          "element": "switch",
          "label": "TRANSLATE.X10.ALLOW_SHELL",
          "doc": "TRANSLATE.X10.ALLOW_SHELL_DOC",
          "value": false,
          "visibleIf": {
            "field": "expert_mode",
            "value": true
          }
        },
        {
          "id": "thd_exclusive",
          "element": "switch",
          "label": "TRANSLATE.X10.THD_EXCLUSIVE",
          "doc": "TRANSLATE.X10.THD_EXCLUSIVE_DOC",
          "value": false,
          "visibleIf": {
            "field": "expert_mode",
            "value": true
          }
        },
        {
          "id": "thd_exclusive_delay",
          "type": "number",
          "element": "input",
          "label": "TRANSLATE.X10.THD_EXCLUSIVE_DELAY",
          "doc": "TRANSLATE.X10.THD_EXCLUSIVE_DELAY_DOC",
          "attributes": [
            {
              "min": 0
            },
            {
              "max": 600
            }
          ],
          "value": 10,
          "visibleIf": {
            "field": "thd_exclusive",
            "value": true
          }
        }
      ]
