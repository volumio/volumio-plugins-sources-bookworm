[Unit]
Description=X10 RF Remote mapper (Volumio plugin x10remote)
After=systemd-udevd.service systemd-modules-load.service
Before=triggerhappy.service
# At most 5 starts per minute - after that the service stays "failed" instead of restarting forever
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=-/sbin/modprobe uinput
ExecStart=/usr/bin/python3 -u /usr/local/bin/x10mapper.py --config /data/configuration/system_hardware/x10remote/mapper.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
# 78 (EX_CONFIG): python3-evdev is missing or /dev/uinput is unusable - a restart does not help
RestartPreventExitStatus=78

# Started by the plugin in onStart and stopped in onStop (not enabled at boot).
[Install]
WantedBy=multi-user.target
