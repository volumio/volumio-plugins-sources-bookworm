[Unit]
Description=EVO Sabre click prevention: the audio output held open
Documentation=https://github.com/foonerd/audiophonics
After=local-fs.target sound.target
Wants=sound.target

[Service]
Type=simple
ExecStart=/data/plugins/system_hardware/audiophonics_evo_sabre/keepalive/audio-keepalive-daemon --pcm evosabreKeepaliveOut --fallback-pcm volumioOutput --rate 44100 --socket /run/evosabre-keepalive/ctl.sock
Restart=always
RestartSec=1
SyslogIdentifier=evosabre-keepalive
User=root
Group=audio

[Install]
WantedBy=multi-user.target
