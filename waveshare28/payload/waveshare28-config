#!/bin/bash
#
# Configure the Waveshare 2.8 inch SPI panel.
#
# Usage:
#   waveshare28-config show
#   waveshare28-config show --json
#   waveshare28-config detect
#   sudo waveshare28-config set rotation=270 backend=framebuffer console=release
#   sudo waveshare28-config set hdmi=on
#   sudo waveshare28-config apply
#   waveshare28-config verify
#   sudo waveshare28-config recover
#   sudo waveshare28-config purge
#
# Operator reference: docs/CONFIG.md
#
# ## Where the truth lives
#
# /boot/waveshare28.conf is the durable copy. /boot survives both an OTA
# (which extracts a tar over it, overwriting only what the tar contains) and a
# factory reset (which reformats the data partition and leaves /boot alone).
# Everything else this tool writes is derived from it and is regenerated by
# `apply`.
#
# A factory reset destroys the root overlay, taking the binary, the unit and
# the module with it, so the installer has to be re-run. The durable file
# surviving means that re-run restores your settings rather than asking again.
#
# ## Two backends
#
# One SPI chip select, one owner. Plymouth needs a framebuffer in the
# initramfs, so fbtft must be in userconfig.txt (firmware-applied, not
# removable). The renderer then cannot open /dev/spidev0.0.
#
# backend=framebuffer keeps those fbtft lines and draws into the fbtft
# node after plymouth-quit. That node is whichever /dev/fbN has the
# sysfs name fb_st7789v. Index is not assumed: HDMI or bcm2708_fb/KMS
# can take fb0 (640x480 on this firmware) and leave the panel on fb1,
# or the panel can be the only node and sit on fb0.
# backend=spi is the original path: it removes the fbtft lines so the
# process can own the bus itself. The two cannot be mixed.
#
# fbtft rotate is counter-clockwise. This file's rotation is clockwise. The
# same physical orientation is a different number in each: rotation=270 is
# dtparam=rotate=90.
#
# cmdline.txt is owned for two tokens only, and only on backend=framebuffer:
# fbcon=map:N (tty1 on the panel framebuffer) and fbcon=font:VGA8x16
# (square QR modules). N is the fb_st7789v index, not a hardcoded 1.
# backend=spi removes them. A kernel OTA replaces cmdline.txt; verify
# reports that, apply puts the tokens back.
#
# console= is framebuffer only. map:N stays on the cmdline so the QR is on
# this panel at boot and when the unit is down. release unbinds fbcon for
# the life of the unit (kernel text cannot overwrite the player) and
# rebinds on stop. share leaves fbcon bound. Ignored on backend=spi.
#
# Volumio writes hdmi_force_hotplug=1 in volumioconfig.txt. On a Pi 4
# that creates a 640x480 HDMI framebuffer and Plymouth binds it.
#
# apply detects the board (device-tree compatible). Pi 4 / 400 / CM4
# plus backend=framebuffer plus hdmi=off (the default) writes:
#
#   [pi4]
#   hdmi_force_hotplug=0
#   [all]
#
# hdmi=on keeps Volumio's force-hotplug: HDMI audio or a real monitor.
# Other boards ignore hdmi=. The [pi4] filter is a second gate so a
# copied userconfig cannot turn off HDMI on a Pi 5. backend=spi removes
# the stanza.
#
# Volumio 4.119 volumioconfig.txt has no Pi 3A+ KMS filter. [pi3] full
# KMS fails to boot 512 MB 3A+ boards. The image fix belongs in
# volumio-os. Until that ships, apply on a 3A+ writes this board's
# revision filter to userconfig.txt only if that scope is absent from
# volumioconfig.txt. Other SBCs get nothing and any leftover block is
# removed. When an OTA adds the scope, the next apply drops our block.

set -euo pipefail

CONF="/boot/waveshare28.conf"
USERCONFIG="/boot/userconfig.txt"
VOLUMIOCONFIG="/boot/volumioconfig.txt"
CMDLINE="/boot/cmdline.txt"
KMS_3A_BEGIN="# waveshare28-3a-kms-begin"
KMS_3A_END="# waveshare28-3a-kms-end"
KMS_3A_OVERLAY="dtoverlay=vc4-kms-v3d,cma-128"
TOML="/etc/waveshare28-panel.toml"
PANEL_FB_NAME="fb_st7789v"
FBCON_FONT="fbcon=font:VGA8x16"
UNIT_DIR="/etc/systemd/system"
BIN_DIR="/usr/local/bin"
UNIT="waveshare28-panel.service"

# Defaults, used when the durable file is absent or partial.
rotation=0
speed=32000000
backend=spi
console=release
hdmi=off
status_text_portrait=normal
status_text_landscape=normal
bar_gap_portrait=default
bar_gap_landscape=default
strip_portrait=progress
strip_landscape=progress
theme=ink
# Set when the durable file itself contained the key. Used to warn when
# the key cannot apply, not because of the default.
console_set=0
hdmi_set=0

log()  { printf '[waveshare28] %s\n' "$*"; }
warn() { printf '[waveshare28] WARNING: %s\n' "$*" >&2; }
die()  { printf '[waveshare28] ERROR: %s\n' "$*" >&2; exit 1; }

require_root() {
    [[ $EUID -eq 0 ]] || die "run as root"
}

validate_rotation() {
    case "$1" in
        0|90|180|270) ;;
        *) die "rotation must be 0, 90, 180 or 270, got '$1'" ;;
    esac
}

validate_backend() {
    case "$1" in
        spi|framebuffer) ;;
        *) die "backend must be spi or framebuffer, got '$1'" ;;
    esac
}

validate_console() {
    case "$1" in
        share|release) ;;
        *) die "console must be share or release, got '$1'" ;;
    esac
}

validate_status_text() {
    case "$1" in
        normal|large) ;;
        *) die "status_text must be normal or large, got '$1'" ;;
    esac
}

validate_bar_gap() {
    case "$1" in
        tight|default|roomy) ;;
        *) die "bar_gap must be tight, default or roomy, got '$1'" ;;
    esac
}

validate_strip() {
    case "$1" in
        progress|stream|off) ;;
        *) die "strip must be progress, stream or off, got '$1'" ;;
    esac
}

validate_theme() {
    case "$1" in
        ink|dusk|studio|night) ;;
        *) die "theme must be ink, dusk, studio or night, got '$1'" ;;
    esac
}

# Keys that only rewrite the toml and restart the unit. They must not
# touch userconfig.txt or cmdline.txt: those are firmware overlays.
is_live_key() {
    case "$1" in
        status_text_portrait|status_text_landscape|bar_gap_portrait|bar_gap_landscape|strip_portrait|strip_landscape|theme)
            return 0
            ;;
        *) return 1 ;;
    esac
}

validate_hdmi() {
    case "$1" in
        off|on) ;;
        *) die "hdmi must be off or on, got '$1'" ;;
    esac
}

dt_compatible() {
    [[ -r /proc/device-tree/compatible ]] || return 0
    tr -d '\0' < /proc/device-tree/compatible 2>/dev/null || true
}

dt_model() {
    [[ -r /proc/device-tree/model ]] || return 0
    tr -d '\0' < /proc/device-tree/model 2>/dev/null || true
}

# bcm2711 is Pi 4, Pi 400 and CM4. Those share Volumio's HDMI force-hotplug.
is_pi4_family() {
    case "$(dt_compatible)" in
        *bcm2711*) return 0 ;;
    esac
    return 1
}

# Pi 3A+ only. Other Pi 3 boards have enough RAM for [pi3] full KMS.
is_pi3a_plus() {
    case "$(dt_compatible)" in
        *3-model-a-plus*) return 0 ;;
    esac
    case "$(dt_model)" in
        *'Pi 3 Model A Plus'*|*'Pi 3A+'*) return 0 ;;
    esac
    return 1
}

# Pi 1, original Zero, CM1. Zero 2 is bcm2837 and is supported.
is_armv6() {
    case "$(dt_compatible)" in
        *bcm2835*) return 0 ;;
    esac
    [[ "$(uname -m)" == armv6l ]]
}

is_raspberry_pi() {
    case "$(dt_compatible)" in
        *raspberrypi*|*brcm,bcm27*) return 0 ;;
    esac
    case "$(dt_model)" in
        *'Raspberry Pi'*) return 0 ;;
    esac
    return 1
}

# Firmware revision tag, warranty bit stripped. Empty if unreadable.
board_revision() {
    local raw
    raw="$(awk -F: '/^Revision/ { gsub(/[[:space:]]/, "", $2); print tolower($2) }' /proc/cpuinfo 2>/dev/null || true)"
    raw="${raw#0x}"
    [[ "$raw" =~ ^[0-9a-f]+$ ]] || return 1
    printf '0x%x' "$((16#$raw & 0xffffff))"
}

# Short family label. Compatible first; model breaks Zero 2 out of Pi 3
# and original Zero / Pi 1 out of bcm2835.
detect_pi() {
    local compat model
    compat="$(dt_compatible)"
    model="$(dt_model)"
    case "$compat" in
        *3-model-a-plus*) printf 'pi3a+'; return 0 ;;
        *model-zero-2*) printf 'pi02'; return 0 ;;
        *bcm2712*) printf 'pi5'; return 0 ;;
        *bcm2711*) printf 'pi4'; return 0 ;;
        *bcm2837*|*bcm2710*)
            case "$model" in
                *'Zero 2'*) printf 'pi02'; return 0 ;;
                *'3 Model A Plus'*|*'3A+'*) printf 'pi3a+'; return 0 ;;
            esac
            printf 'pi3'; return 0
            ;;
        *bcm2836*) printf 'pi2'; return 0 ;;
        *bcm2835*)
            case "$model" in
                *Zero*) printf 'pi0' ;;
                *) printf 'pi1' ;;
            esac
            return 0
            ;;
    esac
    case "$model" in
        *'3 Model A Plus'*|*'3A+'*) printf 'pi3a+' ;;
        *'Zero 2'*) printf 'pi02' ;;
        *'Compute Module 5'*|*'Pi 500'*|*'Pi 5'*) printf 'pi5' ;;
        *'Compute Module 4'*|*'Pi 400'*|*'Pi 4'*) printf 'pi4' ;;
        *'Pi 3'*) printf 'pi3' ;;
        *'Pi 2'*) printf 'pi2' ;;
        *Zero*) printf 'pi0' ;;
        *'Raspberry Pi'*) printf 'pi1' ;;
        *) printf 'unknown' ;;
    esac
}

json_str() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\t'/\\t}"
    s="${s//$'\n'/\\n}"
    printf '"%s"' "$s"
}

json_bool() {
    if [[ "$1" == 1 ]]; then
        printf 'true'
    else
        printf 'false'
    fi
}

kms3a_status() {
    local missing needed
    if ! is_pi3a_plus; then
        printf 'n/a'
        return 0
    fi
    missing="$(missing_3a_kms_rev)"
    needed="$(needed_3a_kms_rev)"
    if [[ -z "$missing" ]]; then
        printf 'present'
    elif [[ -z "$needed" ]]; then
        printf 'userconfig'
    else
        printf 'backstop'
    fi
}

# Machine-readable board + which durable keys apply. No root.
emit_detect_json() {
    local family model revision compat arch reason supported hdmi_ok
    family="$(detect_pi)"
    model="$(dt_model)"
    revision="$(board_revision || true)"
    compat="$(dt_compatible)"
    arch="$(uname -m)"
    reason=""
    supported=1
    if ! is_raspberry_pi; then
        supported=0
        reason="not-a-pi"
    elif is_armv6; then
        supported=0
        reason="armv6"
    fi
    hdmi_ok=0
    if [[ "$supported" -eq 1 ]] && is_pi4_family; then
        hdmi_ok=1
    fi

    printf '{'
    printf '"supported":%s,' "$(json_bool "$supported")"
    printf '"reason":%s,' "$(json_str "$reason")"
    printf '"family":%s,' "$(json_str "$family")"
    printf '"model":%s,' "$(json_str "$model")"
    printf '"revision":%s,' "$(json_str "$revision")"
    printf '"compatible":%s,' "$(json_str "$compat")"
    printf '"arch":%s,' "$(json_str "$arch")"
    printf '"kms3a":%s,' "$(json_str "$(kms3a_status)")"
    printf '"params":{'
    printf '"rotation":%s,' "$(json_bool "$supported")"
    printf '"speed":%s,' "$(json_bool "$supported")"
    printf '"backend":%s,' "$(json_bool "$supported")"
    printf '"console":%s,' "$(json_bool "$supported")"
    printf '"hdmi":%s' "$(json_bool "$hdmi_ok")"
    printf '}}'
    printf '\n'
}

# Write the Pi 4 HDMI-off stanza when this board needs it.
want_pi4_hdmi_off() {
    [[ "$backend" == framebuffer && "$hdmi" == off ]] && is_pi4_family
}

# Clockwise (this file) to counter-clockwise (fbtft rotate=).
fbtft_rotate() {
    case "$1" in
        90)  printf '270' ;;
        270) printf '90' ;;
        *)   printf '%s' "$1" ;;
    esac
}

# Live index of fb_st7789v. Empty if the overlay is not visible yet.
# Name only: a free slot or "the only /dev/fb" can be bcm2708_fb/KMS.
live_panel_fb_index() {
    local d name
    for d in /sys/class/graphics/fb[0-9]*; do
        [[ -e "$d/name" ]] || continue
        name="$(tr -d '[:space:]' < "$d/name")"
        if [[ "$name" == "$PANEL_FB_NAME" ]]; then
            printf '%s' "${d##*/fb}"
            return 0
        fi
    done
    return 1
}

panel_fb_dev() {
    local idx
    idx="$(live_panel_fb_index)" || return 1
    printf '/dev/fb%s' "$idx"
}

# fbtft sizes the node at boot. Clockwise 0/180 is 240×320; 90/270 is 320×240.
fb_layout_virtual_size() {
    case "$rotation" in
        90|270) printf '320,240' ;;
        *) printf '240,320' ;;
    esac
}

panel_fb_virtual_size() {
    local dev name
    dev="$(panel_fb_dev)" || return 1
    name="${dev##*/}"
    [[ -r /sys/class/graphics/${name}/virtual_size ]] || return 1
    tr -d '[:space:]' < "/sys/class/graphics/${name}/virtual_size"
}

# 0 when the live panel fb already matches this rotation's layout.
fb_size_matches_layout() {
    local live want
    [[ "$backend" == framebuffer ]] || return 0
    live="$(panel_fb_virtual_size)" || return 1
    want="$(fb_layout_virtual_size)"
    [[ "$live" == "$want" ]]
}

fbcon_map_token() {
    local idx
    idx="$(live_panel_fb_index)" || return 1
    printf 'fbcon=map:%s' "$idx"
}

# Device the current backend must open. Framebuffer is the live
# fb_st7789v node only; guessing the next free /dev/fbN can select the
# firmware KMS framebuffer. Absent until the next boot when apply has
# just written or removed a firmware overlay.
backend_device() {
    case "$backend" in
        framebuffer) panel_fb_dev ;;
        spi)         printf '/dev/spidev0.0' ;;
    esac
}

load_conf() {
    console_set=0
    hdmi_set=0
    [[ -f "$CONF" ]] || return 0

    local line key value
    while IFS= read -r line; do
        line="${line%%#*}"
        line="${line// /}"
        [[ -n "$line" ]] || continue
        key="${line%%=*}"
        value="${line#*=}"
        case "$key" in
            rotation) rotation="$value" ;;
            speed)    speed="$value" ;;
            backend)  backend="$value" ;;
            console)  console="$value"; console_set=1 ;;
            hdmi)     hdmi="$value"; hdmi_set=1 ;;
            status_text_portrait)  status_text_portrait="$value" ;;
            status_text_landscape) status_text_landscape="$value" ;;
            bar_gap_portrait)      bar_gap_portrait="$value" ;;
            bar_gap_landscape)     bar_gap_landscape="$value" ;;
            strip_portrait)        strip_portrait="$value" ;;
            strip_landscape)       strip_landscape="$value" ;;
            theme)                 theme="$value" ;;
            splash)   warn "'splash' is obsolete; use backend=framebuffer" ;;
            *)        warn "ignoring unknown key in ${CONF}: ${key}" ;;
        esac
    done < "$CONF"
}

save_conf() {
    cat > "$CONF" <<EOF
# Waveshare 2.8 inch SPI panel configuration.
#
# This is the durable copy. It lives on /boot because that partition survives
# both an OTA update and a factory reset, unlike the root filesystem. Every
# other file this configuration produces is derived from it; run
# 'sudo waveshare28-config apply' to regenerate them.

# Panel rotation in degrees clockwise: 0, 90, 180 or 270.
# fbtft rotate is counter-clockwise. rotation=270 is dtparam=rotate=90.
rotation=${rotation}

# SPI clock in Hz. Also the fbtft speed= when backend=framebuffer.
speed=${speed}

# spi: renderer owns the bus. framebuffer: fbtft stays for Plymouth, renderer
# draws into the fbtft node after plymouth-quit.
backend=${backend}

# framebuffer only. What tty1 does while the player is running.
# share:   fbcon stays on the panel (QR always here; kernel text can overwrite)
# release: unbind fbcon for the life of the unit, rebind when it stops
# Ignored on backend=spi.
console=${console}

# Pi 4 framebuffer only. off: cancel Volumio hdmi_force_hotplug=1 so
# Plymouth can use the panel. on: keep HDMI (audio or a real monitor).
# Ignored on other boards and on backend=spi.
hdmi=${hdmi}

# Status screen (hostname, addresses, starting footer). large wraps IPv6.
status_text_portrait=${status_text_portrait}
status_text_landscape=${status_text_landscape}

# Space between volume slider and progress bar. Extra room comes from art,
# never from the transport strip.
bar_gap_portrait=${bar_gap_portrait}
bar_gap_landscape=${bar_gap_landscape}

# Volume-to-transport slot. progress is the shipped bar. stream is IN
# format from getState. off leaves the slot blank.
strip_portrait=${strip_portrait}
strip_landscape=${strip_landscape}

# Colour tokens. ink is the shipped black / white / orange panel.
# dusk, studio and night are ADR-0020 names. Live after set; no reboot.
theme=${theme}
EOF
    log "wrote ${CONF}"
}

# Add a line to userconfig.txt if absent, and refuse anything the firmware
# would silently truncate.
#
# Config lines past 100 characters lose their tail with no warning anywhere,
# which presents as a parameter that appears set and does nothing.
ensure_line() {
    local line="$1"
    [[ ${#line} -lt 100 ]] || die "config line is ${#line} chars, must be under 100"
    [[ -f "$USERCONFIG" ]] || die "${USERCONFIG} not found; is this a Volumio Pi image?"
    grep -qxF "$line" "$USERCONFIG" || {
        log "adding to userconfig.txt: ${line}"
        printf '%s\n' "$line" >> "$USERCONFIG"
    }
}

# True when userconfig.txt already has the Pi 4 HDMI-off stanza.
has_pi4_hdmi_off() {
    [[ -f "$USERCONFIG" ]] || return 1
    awk '
        /^\[pi4\]$/ {
            if ((getline n) > 0 && n == "hdmi_force_hotplug=0") {
                if ((getline n2) > 0 && n2 == "[all]") {
                    found = 1
                    exit
                }
            }
        }
        END { exit !found }
    ' "$USERCONFIG"
}

# Drop a previous HDMI-off form: the [pi4] triplet, or a bare
# hdmi_force_hotplug= left from a hand test.
remove_hdmi_off() {
    [[ -f "$USERCONFIG" ]] || return 0
    local tmp
    tmp="$(mktemp)"
    awk '
        /^\[pi4\]$/ {
            if ((getline n) > 0 && n == "hdmi_force_hotplug=0") {
                if ((getline n2) > 0 && n2 == "[all]") next
                print
                print n
                print n2
                next
            }
            print
            if (n != "") print n
            next
        }
        /^hdmi_force_hotplug=/ { next }
        { print }
    ' "$USERCONFIG" > "$tmp"
    if ! cmp -s "$tmp" "$USERCONFIG"; then
        log "removing from userconfig.txt: hdmi_force_hotplug / [pi4] stanza"
        cat "$tmp" > "$USERCONFIG"
    fi
    rm -f "$tmp"
}

# Framebuffer only. Firmware [pi4] filter so Pi 5 / Pi 3 are untouched.
ensure_pi4_hdmi_off() {
    [[ -f "$USERCONFIG" ]] || die "${USERCONFIG} not found; is this a Volumio Pi image?"
    if has_pi4_hdmi_off; then
        return 0
    fi
    remove_hdmi_off
    log "adding to userconfig.txt: [pi4] hdmi_force_hotplug=0 [all]"
    local tmp
    tmp="$(mktemp)"
    {
        if head -n1 "$USERCONFIG" | grep -q '^#'; then
            head -n1 "$USERCONFIG"
            printf '%s\n' '[pi4]' 'hdmi_force_hotplug=0' '[all]'
            tail -n +2 "$USERCONFIG"
        else
            printf '%s\n' '[pi4]' 'hdmi_force_hotplug=0' '[all]'
            cat "$USERCONFIG"
        fi
    } > "$tmp"
    cat "$tmp" > "$USERCONFIG"
    rm -f "$tmp"
}

# Firmware section header, e.g. [0x9020e0].
config_has_section() {
    local tag="$1" file="$2"
    [[ -f "$file" ]] || return 1
    grep -qiE "^\\[${tag}\\][[:space:]]*$" "$file"
}

volumioconfig_has_section() {
    config_has_section "$1" "$VOLUMIOCONFIG"
}

require_3a_kms_markers() {
    [[ -f "$USERCONFIG" ]] || return 0
    if grep -qF "$KMS_3A_BEGIN" "$USERCONFIG" && ! grep -qF "$KMS_3A_END" "$USERCONFIG"; then
        die "${USERCONFIG} has ${KMS_3A_BEGIN} without ${KMS_3A_END}"
    fi
}

userconfig_without_3a_backstop() {
    [[ -f "$USERCONFIG" ]] || return 0
    awk -v b="$KMS_3A_BEGIN" -v e="$KMS_3A_END" '
        $0 == b { skip = 1; next }
        skip && $0 == e { skip = 0; next }
        skip { next }
        { print }
    ' "$USERCONFIG"
}

# This 3A+'s revision, only when volumioconfig.txt does not already
# have that scope. Empty on every other board.
missing_3a_kms_rev() {
    local rev
    is_pi3a_plus || return 0
    rev="$(board_revision)" || return 0
    volumioconfig_has_section "$rev" || printf '%s\n' "$rev"
}

# Scope we still need to write on this 3A+: missing from
# volumioconfig.txt and not already in the rest of userconfig.txt.
needed_3a_kms_rev() {
    local rev rest
    is_pi3a_plus || return 0
    rev="$(board_revision)" || return 0
    volumioconfig_has_section "$rev" && return 0
    rest="$(userconfig_without_3a_backstop)"
    printf '%s\n' "$rest" | grep -qiE "^\\[${rev}\\][[:space:]]*$" && return 0
    printf '%s\n' "$rev"
}

remove_3a_kms_backstop() {
    [[ -f "$USERCONFIG" ]] || return 0
    require_3a_kms_markers
    grep -qF "$KMS_3A_BEGIN" "$USERCONFIG" || return 0
    local tmp
    tmp="$(mktemp)"
    userconfig_without_3a_backstop > "$tmp"
    log "removing from userconfig.txt: 3A+ KMS backstop"
    cat "$tmp" > "$USERCONFIG"
    rm -f "$tmp"
}

# On a 3A+, write this board's revision filter only when
# volumioconfig.txt (and the rest of userconfig.txt) do not already
# have it. Other SBCs: remove any leftover block, write nothing.
sync_3a_kms_backstop() {
    [[ -f "$USERCONFIG" ]] || die "${USERCONFIG} not found; is this a Volumio Pi image?"
    require_3a_kms_markers
    local needed tmp desired current
    if ! is_pi3a_plus; then
        remove_3a_kms_backstop
        return 0
    fi
    if ! board_revision >/dev/null; then
        warn "Pi 3A+ detected but /proc/cpuinfo Revision is unreadable; not writing a KMS backstop"
        remove_3a_kms_backstop
        return 0
    fi
    needed="$(needed_3a_kms_rev)"
    if [[ -z "$needed" ]]; then
        remove_3a_kms_backstop
        return 0
    fi

    desired="$(
        printf '%s\n' "$KMS_3A_BEGIN" "[${needed}]" "$KMS_3A_OVERLAY" '[all]' "$KMS_3A_END"
    )"
    current="$(awk -v b="$KMS_3A_BEGIN" -v e="$KMS_3A_END" '
        $0 == b { p = 1 }
        p { print }
        $0 == e { p = 0 }
    ' "$USERCONFIG" 2>/dev/null || true)"
    if [[ "$current" == "$desired" ]]; then
        return 0
    fi

    remove_3a_kms_backstop
    tmp="$(mktemp)"
    {
        cat "$USERCONFIG"
        printf '%s\n' "$desired"
    } > "$tmp"
    cat "$tmp" > "$USERCONFIG"
    rm -f "$tmp"
    log "userconfig.txt: 3A+ KMS backstop for ${needed} (absent from volumioconfig.txt)"
}

remove_lines() {
    local pattern="$1"
    grep -qE "$pattern" "$USERCONFIG" 2>/dev/null || return 0
    log "removing from userconfig.txt: ${pattern}"
    sed -i -E "/${pattern}/d" "$USERCONFIG"
}

# cmdline.txt is a single line. Touch only fbcon=* words; everything else
# is Volumio's. An empty write would be a brick, so that is refused.
read_cmdline() {
    [[ -f "$CMDLINE" ]] || die "${CMDLINE} not found; is this a Volumio Pi image?"
    local line
    IFS= read -r line < "$CMDLINE" || true
    printf '%s' "$line"
}

write_cmdline() {
    local line="$1"
    line="$(printf '%s' "$line" | tr -s ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    [[ -n "$line" ]] || die "refusing to write an empty ${CMDLINE}"
    printf '%s\n' "$line" > "$CMDLINE"
    log "wrote ${CMDLINE}"
}

strip_fbcon() {
    local word out=""
    for word in $1; do
        case "$word" in
            fbcon=*) ;;
            *) out="${out:+$out }$word" ;;
        esac
    done
    printf '%s' "$out"
}

# backend=framebuffer: tty1 on the panel framebuffer, 8x16 cells so the
# /etc/issue QR is square. map:N is written only for a live fb_st7789v
# node. Guessing N can put the console on bcm2708_fb/KMS. backend=spi:
# no panel fb, so strip both tokens.
apply_fbcon() {
    local line map
    line="$(strip_fbcon "$(read_cmdline)")"
    if [[ "$backend" == framebuffer ]]; then
        if map="$(fbcon_map_token)"; then
            line="${line} ${map} ${FBCON_FONT}"
            log "cmdline.txt: ${map} ${FBCON_FONT}"
        else
            line="${line} ${FBCON_FONT}"
            log "cmdline.txt: ${FBCON_FONT} (fbcon=map deferred until ${PANEL_FB_NAME} is present)"
        fi
    else
        log "cmdline.txt: removed fbcon= (backend=spi)"
    fi
    write_cmdline "$line"
}

# Bind (1) or unbind (0) the framebuffer vtconsole. Dummy/serial vtcons are
# left alone. Missing vtcon is not fatal: SPI has no panel fb, and a kernel
# without fbcon should not stop the panel starting.
fbcon_bind() {
    local want="$1"
    local d name cur found=0

    for d in /sys/class/vtconsole/vtcon*; do
        [[ -f "$d/name" && -f "$d/bind" ]] || continue
        name="$(tr '[:upper:]' '[:lower:]' < "$d/name")"
        case "$name" in
            *frame*buffer*) ;;
            *) continue ;;
        esac
        found=1
        cur="$(tr -d '[:space:]' < "$d/bind")"
        if [[ "$cur" == "$want" ]]; then
            log "fbcon ${d##*/} already bind=${want}"
            continue
        fi
        printf '%s' "$want" > "$d/bind" || die "writing ${d}/bind"
        log "fbcon ${d##*/} bind=${want}"
    done

    if [[ "$found" -eq 0 ]]; then
        warn "no framebuffer vtconsole found"
    fi
}

write_toml() {
    local fb_line=""
    if [[ "$backend" == framebuffer ]]; then
        local fb_dev
        if fb_dev="$(panel_fb_dev)"; then
            fb_line="fb_dev = \"${fb_dev}\""$'\n'
        fi
    fi
    cat > "$TOML" <<EOF
# Generated by waveshare28-config from ${CONF}. Edits here are overwritten.
backend = "${backend}"
${fb_line}rotation = ${rotation}
spi_speed_hz = ${speed}
status_text_portrait = "${status_text_portrait}"
status_text_landscape = "${status_text_landscape}"
bar_gap_portrait = "${bar_gap_portrait}"
bar_gap_landscape = "${bar_gap_landscape}"
strip_portrait = "${strip_portrait}"
strip_landscape = "${strip_landscape}"
theme = "${theme}"
EOF
    log "wrote ${TOML}"
}

# The unit is deliberately a leaf: nothing in the system depends on it, and it
# depends only on local-fs.target, which is guaranteed.
#
# Two earlier arrangements wedged the boot and are recorded in DEFECTS.md:
#
#   DefaultDependencies=no + Before=basic.target + RequiresMountsFor=/boot
#     is an ordering cycle, because the mount is itself ordered as part of
#     basic.target. systemd broke it by deleting the job.
#
#   After=local-fs.target with Wants= on a unit that is WantedBy=sysinit.target
#     wedged the boot entirely: ping answered, nothing else did.
#
# The pattern here is Volumio's own: allo_relay_attenuator uses
# After=local-fs.target and waits for readiness in its own loop, which is
# exactly what the renderer does.
write_unit() {
    local pre="" post=""
    if [[ "$backend" == framebuffer && "$console" == release ]]; then
        # + runs as root. The panel itself is User=volumio and cannot
        # write /sys/class/vtconsole.
        pre="ExecStartPre=+${BIN_DIR}/waveshare28-config console-release"$'\n'
        post="ExecStopPost=+${BIN_DIR}/waveshare28-config console-share"$'\n'
    fi

    cat > "${UNIT_DIR}/${UNIT}" <<EOF
[Unit]
Description=Waveshare 2.8 inch SPI panel renderer
Documentation=https://github.com/foonerd/rpi-waveshare28
# Not ordered after volumio.service. The renderer shows host addresses until
# the player answers, so waiting would leave the panel dark for the whole boot
# to no purpose.
After=local-fs.target plymouth-quit.service
# Rate limiting lives in [Unit], not [Service]: it moved there in systemd 229
# and only the older StartLimitInterval was ever a [Service] key.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
${pre}ExecStart=${BIN_DIR}/waveshare28-panel
# Bounded failure: a hung start cannot hold the unit open indefinitely, and
# the burst limit above stops a crash loop rather than restarting forever.
TimeoutStartSec=30
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=waveshare28-panel
# SPI backend: /dev/spidev0.0, i2c, gpio. Framebuffer backend: /dev/fbN
# (video group) plus i2c and gpio for touch. Volumio already puts the
# volumio user in spi, i2c and gpio; video is added here for /dev/fbN.
${post}User=volumio
Group=volumio
SupplementaryGroups=spi i2c gpio video

[Install]
WantedBy=multi-user.target
EOF
    log "wrote ${UNIT_DIR}/${UNIT}"
}

# Enable the unit. Start it now only if the backend device already exists.
#
# A firmware overlay written (or removed) in userconfig.txt is not visible
# until the next boot. Starting then would fail, Restart=on-failure would
# loop, and the old "start before enable" gate would refuse to persist a
# unit that is correct for the next boot. That is the case we just hit.
#
# If the device is present, keep the original rule: observe it running
# before enable, so a bad unit still fails while there is a shell.
# If it is not, stop any current instance, enable, and ask for a reboot.
enable_safely() {
    systemctl daemon-reload

    log "checking unit syntax"
    if ! systemd-analyze verify "${UNIT_DIR}/${UNIT}" 2>&1 | tee /tmp/waveshare28-verify.log; then
        die "systemd-analyze verify failed; unit not enabled. See /tmp/waveshare28-verify.log"
    fi
    # verify exits 0 on warnings too, so treat any output as a refusal.
    if [[ -s /tmp/waveshare28-verify.log ]]; then
        cat /tmp/waveshare28-verify.log >&2
        die "systemd-analyze verify reported problems; unit not enabled"
    fi

    local dev live want
    if ! dev="$(backend_device)" || [[ ! -e "$dev" ]]; then
        if [[ "$backend" == framebuffer ]]; then
            log "${PANEL_FB_NAME} is not present; backend=framebuffer applies on the next boot"
            systemctl stop "$UNIT" >/dev/null 2>&1 || true
            systemctl enable "$UNIT" >/dev/null
            log "unit enabled. Reboot for the overlay to load, then the panel starts."
        else
            log "${dev:-/dev/spidev0.0} is not present; not starting the unit"
            systemctl stop "$UNIT" >/dev/null 2>&1 || true
            systemctl enable "$UNIT" >/dev/null
        fi
        return 0
    fi

    # Overlay is live but still the previous boot's size. Starting would
    # exit 1 and Restart=on-failure would loop until StartLimitBurst.
    if [[ "$backend" == framebuffer ]] && ! fb_size_matches_layout; then
        live="$(panel_fb_virtual_size || true)"
        want="$(fb_layout_virtual_size)"
        log "live ${PANEL_FB_NAME} is ${live:-unknown}, layout for rotation=${rotation} is ${want}"
        log "fbtft sizes the node at boot; not starting this boot"
        systemctl stop "$UNIT" >/dev/null 2>&1 || true
        systemctl enable "$UNIT" >/dev/null
        log "unit enabled. Reboot for rotate=$(fbtft_rotate "$rotation") to take effect."
        return 0
    fi

    log "starting before enabling"
    systemctl restart "$UNIT" || die "unit failed to start; not enabled. journalctl -u ${UNIT}"

    # Give it a moment to fall over on its own if it is going to.
    sleep 3
    systemctl is-active --quiet "$UNIT" || {
        systemctl status "$UNIT" --no-pager || true
        die "unit did not stay running; not enabled"
    }

    log "unit is running, enabling for boot"
    systemctl enable "$UNIT" >/dev/null
}

cmd_apply() {
    require_root
    load_conf

    # Validate before writing anything, so a bad value cannot leave the system
    # half configured.
    validate_rotation "$rotation"
    validate_backend "$backend"
    validate_console "$console"
    validate_hdmi "$hdmi"
    validate_status_text "$status_text_portrait"
    validate_status_text "$status_text_landscape"
    validate_bar_gap "$bar_gap_portrait"
    validate_bar_gap "$bar_gap_landscape"
    validate_strip "$strip_portrait"
    validate_strip "$strip_landscape"
    validate_theme "$theme"
    if ! [[ "$speed" =~ ^[0-9]+$ ]] || [[ "$speed" -le 0 ]]; then
        die "speed must be a positive number, got '${speed}'"
    fi
    if [[ "$backend" != framebuffer && "$console_set" -eq 1 ]]; then
        warn "console=${console} is ignored on backend=spi"
    fi
    if [[ "$hdmi_set" -eq 1 ]]; then
        if [[ "$backend" != framebuffer ]]; then
            warn "hdmi=${hdmi} is ignored on backend=spi"
        elif ! is_pi4_family; then
            warn "hdmi=${hdmi} is ignored on $(detect_pi) (Pi 4 family only)"
        fi
    fi

    # Rewrite the display overlay set rather than appending. A leftover
    # rotate= or speed= from a previous apply would otherwise sit next to
    # the new one, and the firmware uses the first match.
    remove_lines '^dtoverlay=(fbtft|mipi-dbi-spi)'
    remove_lines '^dtparam=(width|height|reset_pin|dc_pin|led_pin|rotate)='

    ensure_line "dtparam=spi=on"
    ensure_line "dtoverlay=cst328"

    if [[ "$backend" == framebuffer ]]; then
        if want_pi4_hdmi_off; then
            ensure_pi4_hdmi_off
        else
            remove_hdmi_off
        fi
        local ccw
        ccw="$(fbtft_rotate "$rotation")"
        ensure_line "dtoverlay=fbtft,spi0-0,st7789v"
        ensure_line "dtparam=width=240,height=320"
        ensure_line "dtparam=reset_pin=27,dc_pin=25"
        ensure_line "dtparam=led_pin=18,speed=${speed}"
        ensure_line "dtparam=rotate=${ccw}"
    else
        remove_hdmi_off
    fi

    sync_3a_kms_backstop

    apply_fbcon

    write_toml
    if [[ "$backend" == framebuffer ]]; then
        local fb_dev
        if fb_dev="$(panel_fb_dev)"; then
            log "panel framebuffer is ${fb_dev} (${PANEL_FB_NAME})"
        else
            log "panel framebuffer not on this boot; renderer will find ${PANEL_FB_NAME} after reboot"
            log "run apply again after that boot to pin fbcon=map to the live node"
        fi
    fi
    write_unit
    # Switching away from release replaces the unit before stop, so the new
    # definition has no ExecStopPost to put tty1 back. Do it here.
    if [[ "$backend" != framebuffer || "$console" != release ]]; then
        fbcon_bind 1
    fi
    enable_safely

    log "applied."
    if [[ "$backend" == framebuffer ]]; then
        log "rotation=${rotation} clockwise is dtparam=rotate=$(fbtft_rotate "$rotation")."
    fi
    if [[ "$backend" == framebuffer ]] && ! panel_fb_dev >/dev/null; then
        log "reboot required: ${PANEL_FB_NAME} is not on this boot."
    elif [[ "$backend" == framebuffer ]] && ! fb_size_matches_layout; then
        log "reboot required: live fb is $(panel_fb_virtual_size), layout is $(fb_layout_virtual_size)."
    fi
}

apply_live() {
    write_toml
    if [[ ! -f ${UNIT_DIR}/${UNIT} ]]; then
        log "unit not installed; running a full apply"
        cmd_apply
        return
    fi
    # StartLimitBurst counts every start, including a healthy restart.
    # A/B of live keys is five named sets in two minutes; without this
    # the sixth set dies as "start attempted too often" while the unit
    # never failed. Crash-loop braking stays on Restart=on-failure.
    systemctl reset-failed "$UNIT" 2>/dev/null || true
    systemctl restart "$UNIT" || die "unit failed to restart; journalctl -u ${UNIT}"
    sleep 1
    systemctl is-active --quiet "$UNIT" || {
        systemctl status "$UNIT" --no-pager || true
        die "unit did not stay running after live apply"
    }
    log "applied live keys. boot overlays unchanged."
}

cmd_set() {
    require_root
    load_conf

    local arg key value live_only=1
    for arg in "$@"; do
        key="${arg%%=*}"
        value="${arg#*=}"
        is_live_key "$key" || live_only=0
        case "$key" in
            rotation) rotation="$value" ;;
            speed)    speed="$value" ;;
            backend)  backend="$value" ;;
            console)  console="$value"; console_set=1 ;;
            hdmi)     hdmi="$value"; hdmi_set=1 ;;
            status_text_portrait)  status_text_portrait="$value" ;;
            status_text_landscape) status_text_landscape="$value" ;;
            bar_gap_portrait)      bar_gap_portrait="$value" ;;
            bar_gap_landscape)     bar_gap_landscape="$value" ;;
            strip_portrait)        strip_portrait="$value" ;;
            strip_landscape)       strip_landscape="$value" ;;
            theme)                 theme="$value" ;;
            *)        die "unknown setting: ${key}" ;;
        esac
    done

    validate_rotation "$rotation"
    validate_backend "$backend"
    validate_console "$console"
    validate_hdmi "$hdmi"
    validate_status_text "$status_text_portrait"
    validate_status_text "$status_text_landscape"
    validate_bar_gap "$bar_gap_portrait"
    validate_bar_gap "$bar_gap_landscape"
    validate_strip "$strip_portrait"
    validate_strip "$strip_landscape"
    validate_theme "$theme"
    save_conf
    if [[ "$live_only" -eq 1 ]]; then
        apply_live
    else
        cmd_apply
    fi
}

cmd_detect() {
    emit_detect_json
}

cmd_show_json() {
    load_conf
    local source dev
    source="$([[ -f $CONF ]] && echo "$CONF" || echo 'defaults')"
    printf '{'
    printf '"rotation":%s,' "$rotation"
    printf '"speed":%s,' "$speed"
    printf '"backend":%s,' "$(json_str "$backend")"
    printf '"console":%s,' "$(json_str "$console")"
    printf '"hdmi":%s,' "$(json_str "$hdmi")"
    printf '"status_text_portrait":%s,' "$(json_str "$status_text_portrait")"
    printf '"status_text_landscape":%s,' "$(json_str "$status_text_landscape")"
    printf '"bar_gap_portrait":%s,' "$(json_str "$bar_gap_portrait")"
    printf '"bar_gap_landscape":%s,' "$(json_str "$bar_gap_landscape")"
    printf '"strip_portrait":%s,' "$(json_str "$strip_portrait")"
    printf '"strip_landscape":%s,' "$(json_str "$strip_landscape")"
    printf '"theme":%s,' "$(json_str "$theme")"
    printf '"console_set":%s,' "$(json_bool "$console_set")"
    printf '"hdmi_set":%s,' "$(json_bool "$hdmi_set")"
    printf '"source":%s,' "$(json_str "$source")"
    # Reboot is for a firmware overlay that is not visible yet.
    # backend=spi does not need one: a missing /dev/spidev0.0 is not
    # a reboot (Pi 5 exposes the same bus as /dev/spidev10.0).
    if [[ "$backend" == framebuffer ]]; then
        if dev="$(panel_fb_dev)"; then
            printf '"device":%s,' "$(json_str "$dev")"
            if fb_size_matches_layout; then
                printf '"reboot_required":false,'
            else
                printf '"reboot_required":true,'
            fi
        else
            printf '"device":null,'
            printf '"reboot_required":true,'
        fi
    elif dev="$(backend_device)" && [[ -e "$dev" ]]; then
        printf '"device":%s,' "$(json_str "$dev")"
        printf '"reboot_required":false,'
    else
        printf '"device":null,'
        printf '"reboot_required":false,'
    fi
    printf '"board":'
    emit_detect_json | tr -d '\n'
    printf '}\n'
}

cmd_show() {
    if [[ "${1:-}" == --json ]]; then
        cmd_show_json
        return 0
    fi
    load_conf
    printf 'rotation = %s degrees clockwise\n' "$rotation"
    printf 'speed    = %s Hz\n' "$speed"
    printf 'backend  = %s\n' "$backend"
    printf 'status   = portrait=%s landscape=%s\n' "$status_text_portrait" "$status_text_landscape"
    printf 'bar_gap  = portrait=%s landscape=%s\n' "$bar_gap_portrait" "$bar_gap_landscape"
    printf 'strip    = portrait=%s landscape=%s\n' "$strip_portrait" "$strip_landscape"
    printf 'theme    = %s\n' "$theme"
    if [[ "$backend" == framebuffer ]]; then
        printf 'fbtft    = rotate=%s (counter-clockwise)\n' "$(fbtft_rotate "$rotation")"
        local fb_dev map
        if fb_dev="$(panel_fb_dev)"; then
            printf 'fb       = %s (%s)\n' "$fb_dev" "$PANEL_FB_NAME"
        else
            printf 'fb       = %s not registered on this boot\n' "$PANEL_FB_NAME"
        fi
        if map="$(fbcon_map_token)"; then
            printf 'fbcon    = %s %s\n' "$map" "$FBCON_FONT"
        else
            printf 'fbcon    = %s (map deferred until %s)\n' "$FBCON_FONT" "$PANEL_FB_NAME"
        fi
        if want_pi4_hdmi_off; then
            printf 'hdmi     = off ([pi4] force_hotplug=0)\n'
        elif [[ "$hdmi" == on ]]; then
            printf 'hdmi     = on (HDMI kept; Plymouth stays on HDMI)\n'
        else
            printf 'hdmi     = off (ignored on %s)\n' "$(detect_pi)"
        fi
        printf 'console  = %s\n' "$console"
    elif [[ "$console_set" -eq 1 ]]; then
        printf 'console  = %s (ignored on backend=spi)\n' "$console"
    fi
    if [[ "$backend" != framebuffer && "$hdmi_set" -eq 1 ]]; then
        printf 'hdmi     = %s (ignored on backend=spi)\n' "$hdmi"
    fi
    local board rev kms_missing kms_needed
    board="$(detect_pi)"
    if rev="$(board_revision)"; then
        printf 'board    = %s (%s)\n' "$board" "$rev"
    else
        printf 'board    = %s\n' "$board"
    fi
    if ! is_pi3a_plus; then
        printf '3A+ KMS  = n/a on %s\n' "$board"
    else
        kms_missing="$(missing_3a_kms_rev)"
        kms_needed="$(needed_3a_kms_rev)"
        if [[ -z "$kms_missing" ]]; then
            printf '3A+ KMS  = present in volumioconfig.txt\n'
        elif [[ -z "$kms_needed" ]]; then
            printf '3A+ KMS  = %s already in userconfig.txt\n' "$kms_missing"
        else
            printf '3A+ KMS  = userconfig backstop for %s\n' "$kms_needed"
        fi
    fi
    printf 'source   = %s\n' "$([[ -f $CONF ]] && echo "$CONF" || echo 'defaults')"
}

# Report drift without changing anything, exiting non-zero if anything
# differs, so it is usable from a health check.
cmd_verify() {
    load_conf
    local bad=0

    check() {
        if [[ -n "$2" ]]; then
            printf '  ok    %s\n' "$1"
        else
            printf '  DRIFT %s\n' "$1"
            bad=1
        fi
    }

    log "verifying against ${CONF}"

    if ! is_pi3a_plus; then
        check "userconfig.txt has no 3A+ KMS backstop" \
            "$(grep -qF "$KMS_3A_BEGIN" "$USERCONFIG" 2>/dev/null || echo y)"
    else
        local rev
        if rev="$(board_revision)"; then
            if volumioconfig_has_section "$rev"; then
                check "volumioconfig.txt has [${rev}] (no waveshare28 copy)" \
                    "$(awk -v b="$KMS_3A_BEGIN" -v e="$KMS_3A_END" -v r="[${rev}]" '
                        $0 == b { p = 1; next }
                        $0 == e { p = 0; next }
                        p && tolower($0) == tolower(r) { found = 1 }
                        END { exit found }
                    ' "$USERCONFIG" 2>/dev/null && echo y)"
            else
                check "userconfig.txt has this 3A+ [${rev}]" \
                    "$(grep -qiE "^\\[${rev}\\][[:space:]]*$" "$USERCONFIG" 2>/dev/null && echo y)"
            fi
        else
            check "3A+ revision is readable" ""
        fi
    fi
    check "userconfig.txt has dtparam=spi=on" \
        "$(grep -qxF 'dtparam=spi=on' "$USERCONFIG" 2>/dev/null && echo y)"
    check "userconfig.txt has dtoverlay=cst328" \
        "$(grep -qxF 'dtoverlay=cst328' "$USERCONFIG" 2>/dev/null && echo y)"
    if [[ "$backend" == framebuffer ]]; then
        local ccw
        ccw="$(fbtft_rotate "$rotation")"
        if want_pi4_hdmi_off; then
            check "userconfig.txt has [pi4] hdmi_force_hotplug=0" \
                "$(has_pi4_hdmi_off && echo y)"
        else
            check "userconfig.txt has no [pi4] hdmi_force_hotplug=0" \
                "$(has_pi4_hdmi_off || echo y)"
        fi
        check "userconfig.txt has dtoverlay=fbtft,spi0-0,st7789v" \
            "$(grep -qxF 'dtoverlay=fbtft,spi0-0,st7789v' "$USERCONFIG" 2>/dev/null && echo y)"
        check "userconfig.txt has dtparam=rotate=${ccw}" \
            "$(grep -qxF "dtparam=rotate=${ccw}" "$USERCONFIG" 2>/dev/null && echo y)"
    else
        check "userconfig.txt has no firmware-applied display overlay" \
            "$(grep -qE '^dtoverlay=(fbtft|mipi-dbi-spi)' "$USERCONFIG" 2>/dev/null || echo y)"
        check "userconfig.txt has no hdmi_force_hotplug=" \
            "$(grep -qE '^hdmi_force_hotplug=' "$USERCONFIG" 2>/dev/null || echo y)"
    fi
    if [[ -f "$CMDLINE" ]]; then
        if [[ "$backend" == framebuffer ]]; then
            local map
            check "cmdline.txt has ${FBCON_FONT}" \
                "$(grep -qwF "$FBCON_FONT" "$CMDLINE" 2>/dev/null && echo y)"
            if map="$(fbcon_map_token)"; then
                check "cmdline.txt has ${map}" \
                    "$(grep -qwF "$map" "$CMDLINE" 2>/dev/null && echo y)"
            fi
        else
            check "cmdline.txt has no fbcon=" \
                "$(grep -qE '(^|[[:space:]])fbcon=' "$CMDLINE" 2>/dev/null || echo y)"
        fi
    fi
    check "${TOML} exists" "$([[ -f $TOML ]] && echo y)"
    check "${TOML} matches backend" \
        "$(grep -qxF "backend = \"${backend}\"" "$TOML" 2>/dev/null && echo y)"
    check "${TOML} matches rotation" \
        "$(grep -qxF "rotation = ${rotation}" "$TOML" 2>/dev/null && echo y)"
    check "${TOML} matches status_text_portrait" \
        "$(grep -qxF "status_text_portrait = \"${status_text_portrait}\"" "$TOML" 2>/dev/null && echo y)"
    check "${TOML} matches status_text_landscape" \
        "$(grep -qxF "status_text_landscape = \"${status_text_landscape}\"" "$TOML" 2>/dev/null && echo y)"
    check "${TOML} matches bar_gap_portrait" \
        "$(grep -qxF "bar_gap_portrait = \"${bar_gap_portrait}\"" "$TOML" 2>/dev/null && echo y)"
    check "${TOML} matches bar_gap_landscape" \
        "$(grep -qxF "bar_gap_landscape = \"${bar_gap_landscape}\"" "$TOML" 2>/dev/null && echo y)"
    check "${TOML} matches strip_portrait" \
        "$(grep -qxF "strip_portrait = \"${strip_portrait}\"" "$TOML" 2>/dev/null && echo y)"
    check "${TOML} matches strip_landscape" \
        "$(grep -qxF "strip_landscape = \"${strip_landscape}\"" "$TOML" 2>/dev/null && echo y)"
    check "${TOML} matches theme" \
        "$(grep -qxF "theme = \"${theme}\"" "$TOML" 2>/dev/null && echo y)"
    if [[ "$backend" == framebuffer ]]; then
        local fb_dev
        if fb_dev="$(panel_fb_dev)"; then
            check "${TOML} matches fb_dev" \
                "$(grep -qxF "fb_dev = \"${fb_dev}\"" "$TOML" 2>/dev/null && echo y)"
        fi
    fi
    check "unit installed" "$([[ -f ${UNIT_DIR}/${UNIT} ]] && echo y)"
    if [[ "$backend" == framebuffer && "$console" == release ]]; then
        check "unit unbinds fbcon while running" \
            "$(grep -qF 'console-release' "${UNIT_DIR}/${UNIT}" 2>/dev/null && echo y)"
        check "unit rebinds fbcon on stop" \
            "$(grep -qF 'console-share' "${UNIT_DIR}/${UNIT}" 2>/dev/null && echo y)"
    else
        check "unit does not unbind fbcon" \
            "$(grep -qF 'console-release' "${UNIT_DIR}/${UNIT}" 2>/dev/null || echo y)"
    fi
    check "unit enabled" "$(systemctl is-enabled --quiet "$UNIT" 2>/dev/null && echo y)"
    check "binary installed" "$([[ -x ${BIN_DIR}/waveshare28-panel ]] && echo y)"

    [[ $bad -eq 0 ]] || {
        warn "configuration has drifted; run 'sudo waveshare28-config apply'"
        exit 1
    }
    log "no drift"
}

# Derived files apply writes. Inverse of apply minus the durable conf.
remove_derived() {
    if [[ -f "$USERCONFIG" ]]; then
        remove_lines '^dtoverlay=(fbtft|mipi-dbi-spi)'
        remove_lines '^dtoverlay=cst328$'
        remove_lines '^dtparam=spi=on$'
        remove_lines '^dtparam=(width|height|reset_pin|dc_pin|led_pin|rotate)='
        remove_hdmi_off
        # The 3A+ KMS block is a boot-safety backstop, not a panel
        # overlay. Removing it on recover can fail the next boot on
        # 512 MB 3A+ boards while volumioconfig.txt still has [pi3]
        # full KMS. Other boards: drop a leftover copied card.
        if ! is_pi3a_plus; then
            remove_3a_kms_backstop
        fi
    fi
    if [[ -f "$CMDLINE" ]]; then
        write_cmdline "$(strip_fbcon "$(read_cmdline)")"
    fi
    rm -f "$TOML"
}

# Undo everything apply derived. The unit, overlays, fbcon tokens, toml.
# Keeps /boot/waveshare28.conf so a later apply restores the same keys.
cmd_recover() {
    require_root

    log "disabling and removing the unit"
    systemctl disable --now "$UNIT" >/dev/null 2>&1 || true
    # In case the replaced unit no longer had ExecStopPost.
    fbcon_bind 1
    rm -f "${UNIT_DIR}/${UNIT}"
    # Left over from an earlier design that applied an overlay at boot.
    systemctl disable --now waveshare28-splash.service >/dev/null 2>&1 || true
    rm -f "${UNIT_DIR}/waveshare28-splash.service"
    systemctl daemon-reload

    log "removing derived boot and runtime files"
    remove_derived

    log "recovered. ${CONF} kept; run 'sudo waveshare28-config apply' to reinstate."
    log "If the device would not boot, the units live on the data partition"
    log "under /dyn/etc/systemd/ and can be removed with the card in a reader."
}

# recover plus the durable file. A later install starts from defaults.
cmd_purge() {
    require_root
    cmd_recover
    rm -f "$CONF"
    log "purged ${CONF}"
}

main() {
    local cmd="${1:-show}"
    shift || true

    case "$cmd" in
        show)    cmd_show "$@" ;;
        detect)  cmd_detect ;;
        set)     [[ $# -gt 0 ]] || die "set needs at least one key=value"; cmd_set "$@" ;;
        apply)   cmd_apply ;;
        verify)  cmd_verify ;;
        recover) cmd_recover ;;
        purge)   cmd_purge ;;
        # Privileged helpers for the unit. Not part of the operator UI.
        console-release) require_root; fbcon_bind 0 ;;
        console-share)   require_root; fbcon_bind 1 ;;
        *)       die "usage: $0 [show|show --json|detect|set key=value...|apply|verify|recover|purge]" ;;
    esac
}

main "$@"
