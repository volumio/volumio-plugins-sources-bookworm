          "value": 22
        },
        {
          "id": "activeState",
          "element": "input",
          "type": "number",
          "doc": "TRANSLATE.ACTIVE_STATE_DOC",
          "label": "TRANSLATE.ACTIVE_STATE_LBL",
          "value": 0
        },
        {
          "id": "blinkPeriodMs",
          "element": "input",
          "type": "number",
          "doc": "TRANSLATE.BLINK_PERIOD_DOC",
          "label": "TRANSLATE.BLINK_PERIOD_LBL",
          "value": 1000
        }
