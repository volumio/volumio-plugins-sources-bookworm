        "type": "controller",
        "endpoint": "system_hardware/player_status_led",
        "method": "saveSettings"
      },
      "saveButton": {
        "label": "TRANSLATE.SAVE",
        "data": ["gpioPin", "activeState", "blinkPeriodMs"]
